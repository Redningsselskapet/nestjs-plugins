{
  "name": "@nestjs-plugins/nestjs-nats-jetstream-transport",
  "version": "2.4.0",
  "description": "Nats JetStream Transport for NestJS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Redningsselskapet/nestjs-plugins.git"
  },
  "keywords": [
    "nestjs",
    "transport",
    "microservices",
    "nats",
    "streaming",
    "jetstream",
    "pubsub",
    "event",
    "messaging"
  ],
  "scripts": {
    "test": "jest",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand --forceExit",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "watch": "tsc -w -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\""
  },
  "author": "Bernt Anker [bernt.anker@gmail.com]",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "nats": "^2.19.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.4.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/microservices": "^11.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "^5.33.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "gitHead": "9e421b9dc56d345d607c19f74570164e08679224",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "peerDependencies": {
    "@nestjs/common": "^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/microservices": "^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0"
  }
}
